<?xml version="1.0" encoding="UTF-8"?>
<dc-workflow workflow_id="step-cstep-application"
             title="STEP / CSTEP Application"
             description="Application intake for the STEP and CSTEP programs. States follow the program's decision table; the transition out of 'submitted' is fired by the eligibility event handler, not chosen by the applicant."
             state_variable="review_state"
             initial_state="draft"
             manager_bypass="False">

 <permission>Access contents information</permission>
 <permission>Modify portal content</permission>
 <permission>View</permission>
 <permission>c_step_intake: Review Application</permission>
 <permission>c_step_intake: Decide Application</permission>

 <!-- Applicant is filling in the form. Program staff cannot see it yet. -->
 <state state_id="draft" title="Draft">
  <exit-transition transition_id="submit"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False"/>
  <permission-map name="c_step_intake: Decide Application" acquired="False"/>
 </state>

 <!-- Submitted and evaluated. The applicant can no longer edit. -->
 <state state_id="submitted" title="Submitted">
  <exit-transition transition_id="request_info"/>
  <exit-transition transition_id="flag_for_review"/>
  <exit-transition transition_id="accept"/>
  <exit-transition transition_id="reject"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <!-- Something is missing. The applicant regains edit rights. -->
 <state state_id="request_more_info" title="More information requested">
  <exit-transition transition_id="resubmit"/>
  <exit-transition transition_id="reject"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <!-- Resubmitted after a request for more information. Kept distinct from
      'submitted' so staff can tell a first submission from a follow-up. -->
 <state state_id="resubmitted" title="Resubmitted">
  <exit-transition transition_id="request_info"/>
  <exit-transition transition_id="flag_for_review"/>
  <exit-transition transition_id="accept"/>
  <exit-transition transition_id="reject"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <!-- Awaiting a human decision. Every complete application lands here until
      the automated eligibility criteria are defined and signed off. -->
 <state state_id="manual_review" title="Manual review">
  <exit-transition transition_id="request_info"/>
  <exit-transition transition_id="accept"/>
  <exit-transition transition_id="reject"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <state state_id="accepted" title="Accepted">
  <exit-transition transition_id="reopen"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <state state_id="rejected" title="Rejected">
  <exit-transition transition_id="reopen"/>
  <permission-map name="Access contents information" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="Modify portal content" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="View" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>Owner</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Review Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>ProgramStaff</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
  <permission-map name="c_step_intake: Decide Application" acquired="False">
   <permission-role>Manager</permission-role>
   <permission-role>ProgramDirector</permission-role>
   <permission-role>Site Administrator</permission-role>
  </permission-map>
 </state>

 <transition transition_id="submit" title="Submit application"
             new_state="submitted" trigger="USER"
             before_script="" after_script="">
  <description>Applicant submits. Triggers the eligibility evaluation.</description>
  <action url="%(content_url)s/content_status_modify?workflow_action=submit"
          category="workflow" icon="">Submit</action>
  <guard>
   <guard-role>Manager</guard-role>
   <guard-role>Owner</guard-role>
   <guard-role>Site Administrator</guard-role>
  </guard>
 </transition>

 <transition transition_id="resubmit" title="Resubmit application"
             new_state="resubmitted" trigger="USER"
             before_script="" after_script="">
  <description>Applicant resubmits after supplying missing information. Triggers a fresh evaluation.</description>
  <action url="%(content_url)s/content_status_modify?workflow_action=resubmit"
          category="workflow" icon="">Resubmit</action>
  <guard>
   <guard-role>Manager</guard-role>
   <guard-role>Owner</guard-role>
   <guard-role>Site Administrator</guard-role>
  </guard>
 </transition>

 <transition transition_id="request_info" title="Request more information"
             new_state="request_more_info" trigger="USER"
             before_script="" after_script="">
  <description>Return the application to the applicant for missing information.</description>
  <action url="%(content_url)s/content_status_modify?workflow_action=request_info"
          category="workflow" icon="">Request more information</action>
  <guard>
   <guard-permission>c_step_intake: Review Application</guard-permission>
  </guard>
 </transition>

 <transition transition_id="flag_for_review" title="Flag for manual review"
             new_state="manual_review" trigger="USER"
             before_script="" after_script="">
  <description>Route the application to staff for a human decision.</description>
  <action url="%(content_url)s/content_status_modify?workflow_action=flag_for_review"
          category="workflow" icon="">Flag for review</action>
  <guard>
   <guard-permission>c_step_intake: Review Application</guard-permission>
  </guard>
 </transition>

 <transition transition_id="accept" title="Accept application"
             new_state="accepted" trigger="USER"
             before_script="" after_script="">
  <action url="%(content_url)s/content_status_modify?workflow_action=accept"
          category="workflow" icon="">Accept</action>
  <guard>
   <guard-permission>c_step_intake: Decide Application</guard-permission>
  </guard>
 </transition>

 <transition transition_id="reject" title="Reject application"
             new_state="rejected" trigger="USER"
             before_script="" after_script="">
  <action url="%(content_url)s/content_status_modify?workflow_action=reject"
          category="workflow" icon="">Reject</action>
  <guard>
   <guard-permission>c_step_intake: Decide Application</guard-permission>
  </guard>
 </transition>

 <transition transition_id="reopen" title="Reopen application"
             new_state="manual_review" trigger="USER"
             before_script="" after_script="">
  <description>Reopen a decided application for correction or appeal. The prior decision stays in the audit trail.</description>
  <action url="%(content_url)s/content_status_modify?workflow_action=reopen"
          category="workflow" icon="">Reopen</action>
  <guard>
   <guard-permission>c_step_intake: Decide Application</guard-permission>
  </guard>
 </transition>

 <worklist worklist_id="review_queue" title="">
  <description>Applications awaiting a staff decision</description>
  <action url="%(portal_url)s/search?review_state=manual_review"
          category="global" icon="">Applications to review (%(count)d)</action>
  <guard>
   <guard-permission>c_step_intake: Review Application</guard-permission>
  </guard>
  <match name="review_state" values="manual_review"/>
 </worklist>

 <variable variable_id="action" for_catalog="False" for_status="True" update_always="True">
  <description>The last transition</description>
  <default><expression>transition/getId|nothing</expression></default>
  <guard/>
 </variable>
 <variable variable_id="actor" for_catalog="False" for_status="True" update_always="True">
  <description>The ID of the user who performed the last transition</description>
  <default><expression>user/getId</expression></default>
  <guard/>
 </variable>
 <variable variable_id="comments" for_catalog="False" for_status="True" update_always="True">
  <description>Comments about the last transition</description>
  <default><expression>python:state_change.kwargs.get('comment', '')</expression></default>
  <guard/>
 </variable>
 <variable variable_id="review_history" for_catalog="False" for_status="False" update_always="False">
  <description>Provides access to workflow history</description>
  <default><expression>state_change/getHistory</expression></default>
  <guard>
   <guard-permission>c_step_intake: Review Application</guard-permission>
  </guard>
 </variable>
 <variable variable_id="time" for_catalog="False" for_status="True" update_always="True">
  <description>Time of the last transition</description>
  <default><expression>state_change/getDateTime</expression></default>
  <guard/>
 </variable>

</dc-workflow>
