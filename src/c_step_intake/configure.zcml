<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  i18n_domain="c_step_intake">

  <i18n:registerTranslations directory="locales"/>

  <include file="permissions.zcml"/>
  <include package=".behaviors"/>

  <genericsetup:registerProfile
    name="default"
    title="c_step_intake"
    directory="profiles/default"
    description="STEP student application intake. CSTEP is off until the cstep profile is applied."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.post_install"
  />

  <!-- CSTEP toggle: applying this profile adds the cstep_application type and
       binds it to the workflow. See "Enabling CSTEP" in the README. -->
  <genericsetup:registerProfile
    name="cstep"
    title="c_step_intake: CSTEP applications"
    directory="profiles/cstep"
    description="Enables the CSTEP application type. Not ready for production."
    provides="Products.GenericSetup.interfaces.EXTENSION"
  />

  <genericsetup:registerProfile
    name="uninstall"
    title="c_step_intake (uninstall)"
    directory="profiles/uninstall"
    description="Uninstalls the c_step_intake add-on."
    provides="Products.GenericSetup.interfaces.EXTENSION"
    post_handler=".setuphandlers.uninstall"
  />

  <utility
    factory=".setuphandlers.HiddenProfiles"
    name="c_step_intake-hiddenprofiles"
  />

  <!-- Both application types implement IApplication, so the eligibility
       handler is registered once. Bound to the workflow transition, not to
       IObjectModifiedEvent: see event_handlers.evaluate_application. -->
  <subscriber
    for="c_step_intake.interfaces.IApplication
         Products.DCWorkflow.interfaces.IAfterTransitionEvent"
    handler=".event_handlers.evaluate_application"
  />

</configure>
